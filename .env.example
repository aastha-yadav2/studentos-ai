# Browser-safe public values from Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secret: configure this with Supabase, never in a VITE_* variable.
# supabase secrets set GEMINI_API_KEY=your-gemini-api-key


# SERVER SECRET — set with Supabase CLI; never put this in .env.local as VITE_*
# supabase secrets set OPENAI_API_KEY=your-openai-api-key
